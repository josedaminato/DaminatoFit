{
  "name": "@daminatofit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start:daminatofit": "cross-env APP_BRAND=daminatofit expo start",
    "start:pupiapp": "cross-env APP_BRAND=pupiapp expo start",
    "config:daminatofit": "cross-env APP_BRAND=daminatofit expo config --type public",
    "config:pupiapp": "cross-env APP_BRAND=pupiapp expo config --type public",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@daminatofit/brand": "workspace:*",
    "@daminatofit/contracts": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ]
  }
}
