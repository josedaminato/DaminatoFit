{
  "name": "@daminatofit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/server.cjs",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "notifications:once": "tsx --env-file-if-exists=../../.env src/notification-worker.ts",
    "admin:provision": "tsx --env-file-if-exists=../../.env src/admin-provision.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --env-file-if-exists=../../.env ../../node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@better-auth/expo": "^1.7.27",
    "@daminatofit/brand": "workspace:*",
    "@daminatofit/contracts": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.3.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ffprobe-static": "^3.1.0",
    "file-type": "^22.3.0",
    "image-size": "^2.1.0",
    "nodemailer": "^10.6.1",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@daminatofit/config": "workspace:*",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
