{
  "name": "daminatofit",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:api": "pnpm --filter @daminatofit/api dev",
    "mobile:daminatofit": "pnpm --filter @daminatofit/mobile start:daminatofit",
    "mobile:pupiapp": "pnpm --filter @daminatofit/mobile start:pupiapp",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "gitleaks detect --source . --verbose --redact",
    "deps:audit": "pnpm audit --prod --audit-level=high",
    "db:migrate": "pnpm --filter @daminatofit/api db:migrate",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm deps:audit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
