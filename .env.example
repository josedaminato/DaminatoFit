# Copy to .env for local development. Values are throwaway local defaults, not real credentials.

# --- API ---
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
API_PUBLIC_URL=http://127.0.0.1:3000
LOG_LEVEL=info

# Better Auth (min 32 chars). Local placeholder only — never use in production.
BETTER_AUTH_SECRET=local_dev_only_change_me_32chars_min
# PupiApp one-time bootstrap (local placeholder). Omit in shared environments.
PUPIAPP_BOOTSTRAP_SECRET=local_pupiapp_bootstrap

# --- Local infrastructure (infra/docker/compose.yml) ---
POSTGRES_USER=daminatofit
POSTGRES_PASSWORD=daminatofit_dev
POSTGRES_DB=daminatofit
POSTGRES_PORT=5442

# Migrator / owner connection (runs migrations + Better Auth schemas).
DATABASE_URL=postgres://daminatofit:daminatofit_dev@127.0.0.1:5442/daminatofit
# API runtime role (NOBYPASSRLS). Created by migration 0001_init.sql.
DATABASE_URL_APP=postgres://app_user:app_user_dev@127.0.0.1:5442/daminatofit
# Platform admin role (audited, still NOBYPASSRLS).
DATABASE_URL_ADMIN=postgres://app_admin:app_admin_dev@127.0.0.1:5442/daminatofit

S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=daminatofit
S3_SECRET_ACCESS_KEY=daminatofit_dev_secret
S3_REGION=us-east-1
S3_BUCKET=daminatofit-media
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Provisional technical media limits (not commercial policy)
MEDIA_MAX_BYTES=52428800
MEDIA_MAX_DURATION_MS=180000
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_PLAYBACK_URL_TTL_SECONDS=300
DEFAULT_STORAGE_QUOTA_BYTES=536870912
# Optional: path to ffprobe for duration/codec checks
# FFPROBE_PATH=ffprobe

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=noreply@daminatofit.local
MAIL_UI_PORT=8025

APP_LINK_BASE_DAMINATOFIT=daminatofit://invite
APP_LINK_BASE_PUPIAPP=pupiapp://invite
